rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if user owns this tenant (tenantId == uid)
    function isOwner(tenantId) {
      return request.auth != null && request.auth.uid == tenantId;
    }

    // Check if user has custom claims linking to a tenant
    function hasTenantClaim() {
      return request.auth != null && request.auth.token.tenantId != null;
    }

    // Check if user is member of the tenant (owner OR team member via claims)
    function isTenantMember(tenantId) {
      return isOwner(tenantId) || (hasTenantClaim() && request.auth.token.tenantId == tenantId);
    }

    // Has anyone claimed ownership of this self-hosted instance yet?
    function instanceClaimed() {
      return exists(/databases/$(database)/documents/platform_config/admins);
    }

    // Instance owners are listed in platform_config/admins.uids.
    // Until that document exists, the first signed-in user may create it,
    // which is how a fresh deployment is claimed by whoever installs it.
    function isInstanceAdmin() {
      return request.auth != null
        && instanceClaimed()
        && request.auth.uid in get(/databases/$(database)/documents/platform_config/admins).data.uids;
    }

    // --- Instance admin list ---
    match /platform_config/admins {
      allow read: if request.auth != null;
      // First-run claim: any signed-in user, but only while unclaimed, and only
      // when listing themselves. Afterwards, existing admins manage the list.
      allow create: if request.auth != null
        && !instanceClaimed()
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 1
        && request.resource.data.uids[0] == request.auth.uid;
      allow update: if isInstanceAdmin();
      allow delete: if false;
    }

    // --- API keys and other instance config (owners only) ---
    match /platform_config/{docId} {
      allow read, write: if isInstanceAdmin();
    }

    // --- Market Config (read for authenticated, write for instance owners) ---
    match /market_config/{marketId} {
      allow read: if request.auth != null;
      allow write: if isInstanceAdmin();
    }

    // --- Tenants ---
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow create: if false; // Only Cloud Functions create tenants
      allow update: if isTenantMember(tenantId)
        && request.resource.data.market == resource.data.market; // Market is immutable
      allow delete: if false;

      // --- Leads (subcollection) ---
      match /leads/{leadId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isTenantMember(tenantId);
        allow update: if isTenantMember(tenantId);
        allow delete: if false;

        // --- Messages (sub-subcollection, append-only) ---
        match /messages/{messageId} {
          allow read: if isTenantMember(tenantId);
          allow create: if isTenantMember(tenantId);
          allow update, delete: if false;
        }
      }

      // --- Appointments (subcollection) ---
      match /appointments/{appointmentId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isTenantMember(tenantId);
        allow update: if isTenantMember(tenantId);
        allow delete: if false;
      }
    }

    // --- OAuth state (Cloud Functions only) ---
    match /oauth_states/{stateId} {
      allow read, write: if false;
    }

    // --- Phone Mappings (Cloud Functions only) ---
    match /phone_mappings/{phoneNumberId} {
      allow read, write: if false;
    }

    // --- Usage Logs (read for tenant members, write via Cloud Functions only) ---
    match /usage_logs/{logId} {
      allow read: if request.auth != null
        && resource.data.tenantId == request.auth.uid;
      allow write: if false;
    }

    // --- Compliance Logs (read for tenant owner, write via Cloud Functions only) ---
    match /compliance_log/{logId} {
      allow read: if request.auth != null
        && resource.data.tenantId == request.auth.uid;
      allow write: if false;
    }

    // --- Default deny all ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
