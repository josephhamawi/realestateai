# Port the gateway HTTP server listens on
PORT=8080

# Shared secret required on the POST /messages endpoint (must match the app's Gateway Secret)
GATEWAY_SECRET=change-me-to-a-long-random-string

# The Cloud Function webhook URL that inbound messages are forwarded to
WEBHOOK_URL=https://us-central1-your-project.cloudfunctions.net/whatsappWebhook

# Token appended as ?token= on webhook calls (must match the app's WhatsApp Verify Token)
VERIFY_TOKEN=change-me-to-match-verify-token

# Synthetic phone_number_id this gateway reports, used by the app to map the tenant
PHONE_NUMBER_ID=baileys-dubai-1

# Directory where the Baileys session is persisted on disk across restarts
AUTH_DIR=./auth
