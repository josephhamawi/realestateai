# RealEstateAI: Cloud Functions environment variables (all optional).
#
# Every key here can instead be entered in the app's API Keys screen, which
# stores it in your own Firestore. Environment variables take priority.
# Copy to functions/.env.local for the emulators, or set them on the deployed
# functions with: firebase functions:config or gcloud run services update.

# --- AI providers: at least one is required for the assistant to reply ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Public base URL of your deployed app (OAuth redirects, calendar invites) ---
APP_BASE_URL=
APP_FROM_EMAIL=

# --- WhatsApp (optional): meta | 360dialog | baileys ---
WHATSAPP_PROVIDER=meta
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
D360_API_KEY=
BAILEYS_GATEWAY_URL=
BAILEYS_GATEWAY_SECRET=

# --- Telegram (optional, free) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Calendar OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
